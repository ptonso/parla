# TeX Live install profile for the parla-texlive image.
# Paths target the image's /usr/local/texlive.
selected_scheme scheme-small
TEXDIR /usr/local/texlive
TEXMFLOCAL /usr/local/texlive/texmf-local
TEXMFSYSCONFIG /usr/local/texlive/texmf-sys-config
TEXMFSYSVAR /usr/local/texlive/texmf-sys-var
TEXMFVAR /usr/local/texlive/texmf-var
collection-basic 1
collection-latex 1
collection-latexrecommended 1
collection-xetex 1
option_doc 0
option_src 0
